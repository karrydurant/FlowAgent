<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.flowagent</groupId>
        <artifactId>flowagent-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>flowagent-observability</artifactId>
    <packaging>jar</packaging>
    <name>FlowAgent Observability</name>
    <description>可观测性模块 — Agent 全链路追踪、成本追踪、监控面板</description>

    <dependencies>
        <dependency>
            <groupId>com.flowagent</groupId>
            <artifactId>flowagent-common</artifactId>
        </dependency>
        <!--
          Redis：成本统计与日预算要跨副本聚合（CostStore 的 Redis 实现）。
          此前是经 flowagent-common 传递获得的；显式声明是因为这里直接使用了
          org.redisson.api.* —— 靠传递依赖拿到的编译期可见性是「碰巧成立」，
          common 哪天把 redisson 换成别的客户端，这里会以一个看不懂的编译错误暴露。
        -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
    </dependencies>
</project>
